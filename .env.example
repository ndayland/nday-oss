# Copy to .env and adjust. Real environment variables take precedence over .env.
NDAY_DATABASE_URL=postgresql://nday:nday@127.0.0.1:54329/nday
# Used by pytest; the database is created automatically if missing.
NDAY_TEST_DATABASE_URL=postgresql://nday:nday@127.0.0.1:54329/nday_test
# Database settings (docs/settings.md): the collector, discussion and sign-in variables below can
# also be stored in the database on /admin/settings (database > environment > default). Secrets
# stored there are sealed with this master key (environment only): openssl rand -base64 32
# NDAY_SETTINGS_KEY=
# cvelist collector: first-run window in days (0..30) and max record files per run.
# NDAY_CVELIST_BOOTSTRAP_DAYS=7
# NDAY_CVELIST_MAX_FILES=1000
# ghsa collector (GitHub Advisory Database REST API, reviewed advisories only):
# first-run window by `updated` in days (0..90), max list requests per run (100 advisories
# each), re-query overlap in minutes. Unauthenticated quota is 60 requests/hour per IP;
# an optional token raises it (sent as Bearer, never logged).
# NDAY_GHSA_BOOTSTRAP_DAYS=7
# NDAY_GHSA_MAX_REQUESTS=10
# NDAY_GHSA_OVERLAP_MINUTES=60
# NDAY_GITHUB_TOKEN=
# cvelist on-demand backfill: days before a wanted CVE whose record file was 404 is requested again.
# NDAY_CVELIST_BACKFILL_RETRY_DAYS=7
# xposts collector (X API v2 recent search, app-only Bearer token; never logged). The token can
# instead be stored encrypted in the database on /admin/settings (needs NDAY_SETTINGS_KEY; the
# database value wins, this variable stays the fallback; docs/settings.md).
# Allowlist and run limits live in the database: nday x-accounts-import / x-accounts-list /
# x-settings (docs/xposts.md). Without a token or enabled accounts, `collect xposts` is a no-op.
# NDAY_X_BEARER_TOKEN=
# Hot list pinning (internal/site/pin.go, docs/api.md /api/hot "pinned"; also on /admin/settings):
# at most MAX CVEs (0..20, 0 = off) with at least RESEARCHERS distinct researchers in 7 days (1..100),
# the latest post at most RECENT_HOURS old (1..168) and the current wave begun at most WAVE_DAYS ago
# (1..30; a wave ends at a silence longer than WAVE_DAYS) go first on the first page; if fewer than
# MAX qualify, the rest is filled from the top of the /discussed ranking (0 also turns the fill off).
# NDAY_HOT_PIN_MAX=10
# NDAY_HOT_PIN_RESEARCHERS=2
# NDAY_HOT_PIN_RECENT_HOURS=72
# NDAY_HOT_PIN_WAVE_DAYS=7
