# /etc/nday/auth.env — sign-in configuration for nday serve (docs/auth.md §6).
# Owner root:nday, mode 0640. Placeholders only: replace every <...>.
# A provider is enabled only when ALL of its variables are set; a partly
# configured provider makes `nday serve` refuse to start.
# Most of these (provider ids and secrets, passkeys, session times, terms
# version, the discussion limits) can instead be stored in the database on
# /admin/settings, which wins over this file (docs/settings.md). Never there:
# NDAY_PUBLIC_URL, NDAY_AUTH_SECRET(_PREVIOUS), NDAY_AUTH_RP_ID,
# NDAY_AUTH_ORIGINS, NDAY_AUTH_APPLE_KEY_FILE, NDAY_DISCUSS_DB_POOL_SIZE.

# Public origin (also used by the HTML pages). Must be https. An explicit
# default port (:443) is dropped. /auth/*, /account/* and /api/me answer only
# requests whose Host is this origin's host (others: 421). Any other
# Host that is not the bare apex, the API host or a loopback name is not
# served at all: GET/HEAD get a 308 to this origin, other methods 421.
NDAY_PUBLIC_URL=https://www.nday.land

# Server secret for sealed cookies, session tags and CSRF tokens:
#   openssl rand -base64 48
# (openssl rand -hex 32 is accepted too). Obviously non-random values (one
# repeated character, a short repeated pattern, fewer than 16 distinct byte
# values) make `nday serve` refuse to start.
NDAY_AUTH_SECRET=<base64 of at least 32 random bytes>
# During a rotation, the old value (remove after ~1 day):
#NDAY_AUTH_SECRET_PREVIOUS=<previous NDAY_AUTH_SECRET>

# Google — https://www.nday.land/auth/google/callback
#NDAY_AUTH_GOOGLE_CLIENT_ID=<client id>.apps.googleusercontent.com
#NDAY_AUTH_GOOGLE_CLIENT_SECRET=<client secret>

# Apple — https://www.nday.land/auth/apple/callback
#NDAY_AUTH_APPLE_SERVICES_ID=<services id, e.g. land.nday.web>
#NDAY_AUTH_APPLE_TEAM_ID=<10-character Team ID>
#NDAY_AUTH_APPLE_KEY_ID=<10-character Key ID>
#NDAY_AUTH_APPLE_KEY_FILE=/etc/nday/apple/AuthKey_<KEY ID>.p8

# GitHub — https://www.nday.land/auth/github/callback
#NDAY_AUTH_GITHUB_CLIENT_ID=<client id>
#NDAY_AUTH_GITHUB_CLIENT_SECRET=<client secret>

# X — https://www.nday.land/auth/x/callback (OAuth 2.0 client id/secret, not the API key)
#NDAY_AUTH_X_CLIENT_ID=<oauth2 client id>
#NDAY_AUTH_X_CLIENT_SECRET=<oauth2 client secret>

# Passkeys (on by default when a provider is configured).
#NDAY_AUTH_PASSKEYS=on
#NDAY_AUTH_RP_ID=nday.land
#NDAY_AUTH_ORIGINS=https://www.nday.land
# Passkey-only sign-up (creates accounts without any provider): off by default.
#NDAY_AUTH_PASSKEY_SIGNUP=off
# ...when on: at most this many new passkey-only accounts per UTC day (all
# clients together), and per client address a burst of 3, then one per interval.
#NDAY_AUTH_PASSKEY_SIGNUP_DAILY=200
#NDAY_AUTH_PASSKEY_SIGNUP_INTERVAL=1h
# Passkeys per account.
#NDAY_AUTH_MAX_PASSKEYS=20
# Registering a passkey, linking an identity and deleting the account need a
# sign-in at most this old (else 403 reauth_required).
#NDAY_AUTH_SENSITIVE_WINDOW=15m

# Optional
#NDAY_TERMS_VERSION=<current terms version, e.g. 2026-11-01>
#NDAY_AUTH_SESSION_IDLE=14d
#NDAY_AUTH_SESSION_MAX=60d
#NDAY_AUTH_HANDLE_HOLD=90d
#NDAY_AUTH_DB_POOL_SIZE=4

# Discussions (docs/discuss.md). On whenever accounts are enabled; set
# NDAY_DISCUSS=off to switch them off. Posting requires the current
# NDAY_TERMS_VERSION to be accepted, so publish the community rules and set
# NDAY_TERMS_VERSION before opening discussions. Defaults shown.
#NDAY_DISCUSS=on
#NDAY_DISCUSS_DB_POOL_SIZE=4
#NDAY_DISCUSS_POST_BURST=5
#NDAY_DISCUSS_POST_EVERY=30s
#NDAY_DISCUSS_POST_DAILY=60
#NDAY_DISCUSS_NEW_POST_BURST=2
#NDAY_DISCUSS_NEW_POST_EVERY=2m
#NDAY_DISCUSS_NEW_POST_DAILY=10
#NDAY_DISCUSS_NEW_ACCOUNT_AGE=24h
#NDAY_DISCUSS_NEW_ACCOUNT_COMMENTS=3
#NDAY_DISCUSS_ADDR_BURST=10
#NDAY_DISCUSS_ADDR_EVERY=10s
#NDAY_DISCUSS_EDIT_BURST=20
#NDAY_DISCUSS_EDIT_EVERY=3m
#NDAY_DISCUSS_REPORT_DAILY=20
#NDAY_DISCUSS_REPORT_BURST=5
#NDAY_DISCUSS_REPORT_EVERY=1m
#NDAY_DISCUSS_DELETE_BURST=10
#NDAY_DISCUSS_DELETE_EVERY=30s
#NDAY_DISCUSS_READ_BURST=120
#NDAY_DISCUSS_READ_EVERY=500ms
#NDAY_DISCUSS_MOD_BURST=600
#NDAY_DISCUSS_MOD_EVERY=100ms
#NDAY_DISCUSS_DUPLICATE_WINDOW=10m
#NDAY_DISCUSS_GUEST_READ=on
#NDAY_DISCUSS_GUEST_READ_BURST=60
#NDAY_DISCUSS_GUEST_READ_EVERY=2s
# Readers' corrections of vulnerability pages (docs/corrections.md; also
# database settings): per-user 24-hour cap, open ones per vulnerability (all
# readers) and per user on one vulnerability, per-user request bucket.
#NDAY_CORRECTIONS_DAILY=10
#NDAY_CORRECTIONS_OPEN_PER_VULN=20
#NDAY_CORRECTIONS_OPEN_PER_USER=3
#NDAY_CORRECTIONS_BURST=3
#NDAY_CORRECTIONS_EVERY=1m
