     {
      "authoritative": true,
      "cve_id": "CVE-2026-117373",
      "description": "Janus WebRTC Server 1.2.3 through 1.4.0 is vulnerable to Directory Traversal. The application accepts a caller supplied media path when an ondemand stream is created. The path is validated only by checking whether it contains one of the audio extensions and is then passed to the file source which opens it. No canonicalization is performed and no directory allowlist is enforced, so an unauthenticated caller can make the server open an arbitrary local file and use it as a media source, with the content delivered to viewers as RTP audio.",
      "modified_at": "2026-11-11T17:36:51.985000Z",
      "published_at": "2026-11-11T00:00:00.000000Z",
      "title": null
     }
