    "vulns": [
     {
      "authoritative": true,
      "cve_id": "CVE-2026-108262",
      "description": "DDEV is an open-source tool for running local web development environments for PHP and Node.js. From 1.25.2 until 1.25.4, Untar in pkg/archive/archive.go validates an absolute tar symlink target after rebasing it beneath dest, but creates the symlink with the raw absolute Linkname. A crafted archive can therefore plant a host-absolute symlink and use a following regular-file entry to write outside the extraction directory. The flaw is reachable through remote add-on retrieval and database or file imports, and overwriting shell startup files, Git hooks, or cron entries can lead to code execution in the DDEV user's context. Unzip is not affected. This issue is fixed in version 1.25.4.",
      "modified_at": "2026-11-11T03:16:39.472000Z",
      "published_at": "2026-11-06T18:29:49.225000Z",
      "title": "DDEV incomplete tar symlink traversal fix allows host file overwrite - Incomplete fix of CVE-2026-32885"
     }
    ]
   },
   "source_key": "CVE-2026-108262"
  },
