{"key":"CVE-2026-105137","payload":{"containers":{"adp":[{"metrics":[{"other":{"content":{"id":"CVE-2026-105137","options":[{"Exploitation":"poc"},{"Automatable":"no"},{"Technical Impact":"partial"}],"role":"CISA Coordinator","timestamp":"2026-10-05T16:00:50.536475Z","version":"2.0.3"},"type":"ssvc"}}],"providerMetadata":{"dateUpdated":"2026-10-05T16:01:01.726Z","orgId":"134c704f-9b21-4f2e-91b3-4a467353bcc0","shortName":"CISA-ADP"},"title":"CISA ADP Vulnrichment"}],"cna":{"affected":[{"cpes":["cpe:2.3:a:laradock:laradock:*:*:*:*:*:*:*:*"],"modules":["Build Process"],"product":"Laradock","vendor":"n/a","versions":[{"status":"affected","version":"20.0"},{"status":"affected","version":"20.1"},{"status":"affected","version":"20.2"},{"status":"affected","version":"20.3"},{"status":"affected","version":"20.4"},{"status":"unaffected","version":"20.5"}]}],"credits":[{"lang":"en","type":"reporter","value":"SahilPunia (VulDB User)"},{"lang":"en","type":"coordinator","value":"VulDB CNA Team"}],"descriptions":[{"lang":"en","value":"A vulnerability was found in Laradock up to 20.4. Impacted is an unknown function of the file workspace/Dockerfile of the component Build Process. The manipulation results in download of code without integrity check. The attack can be launched remotely. A high complexity level is associated with this attack. The exploitability is considered difficult. The exploit has been made public and could be used. Upgrading to version 20.5 is recommended to address this issue. The patch is identified as c3494f432668472056aa0a9134ff4e0d9d2e8cea. You should upgrade the affected component. The vendor confirms: \"The fix replaces the reported plaintext Event and New Relic downloads with HTTPS-only downloads and checks pinned SHA-256 hashes before extracting the archives. We also fixed the Event download in the PHP-FPM Dockerfile, in addition to the locations you identified.\""}],"metrics":[{"cvssV4_0":{"baseScore":2.3,"baseSeverity":"LOW","vectorString":"CVSS:4.0/AV