{{define "content"}}{{with .Data}}
<div class="page">
<div class="wrap">
<main class="main adm" id="main" data-page="admin">
{{template "adminhead" .}}
{{- with .Body}}
<p class="note">{{t "admin.xd.lede"}}</p>
<p class="note">{{if .HasRun}}{{t "admin.xd.run" "time" .RunAt.HTML "created" .Created "candidates" .Cands "carried" .Carried "skipped_cap" .SkipCap "skipped_old" .SkipOld}}{{else}}{{t "admin.xd.run_never"}}{{end}}</p>
{{- if .Deferred}}
<p class="note">{{t "admin.xd.run_deferred" "time" .DeferAt.HTML}}</p>
{{- end}}
<section class="sec" id="pending" aria-labelledby="h-xdp">
<h2 class="h2" id="h-xdp"><span class="h" aria-hidden="true"># </span>{{t "admin.xd.pending_h2" "n" .Total}}</h2>
{{- if .Pending}}
<p class="note">{{t "admin.xd.open_note"}}</p>
<div class="adm-region" id="r-xdpending" data-page-region="r-xdpending" data-bulk="{{.Bulk.Kind}}">
{{template "bulkbar" .Bulk}}
<p class="adm-pickrow"><label>{{template "pickall"}}</label></p>
<div class="adm-list">
{{- $max := .Max}}{{$link := .LinkCost}}
{{- range .Pending}}
<article class="cm adm-cm" id="d-{{.ID}}">
<p class="cm-h"><input type="checkbox" data-pick="" data-id="{{.ID}}" data-version="{{.Version}}" aria-labelledby="{{.Label}}"/>
<span id="{{.Label}}"><span class="{{.CodeClass}} b">+{{.Code}}</span>
{{if .CVEHref}}<a href="{{.CVEHref}}">{{.CVE}}</a>{{else}}<code>{{.CVE}}</code>{{end}}</span>
<span class="cm-time">{{t "admin.xd.created" "time" .Created.HTML}}</span></p>
<form class="acct-form adm-xd" data-d="{{.ID}}" data-v="{{.Version}}" novalidate="">
<label for="xd-body-{{.ID}}" data-label="">{{t "admin.xd.body_label"}}</label>
<textarea class="acct-in adm-ta" id="xd-body-{{.ID}}" name="body" rows="6" spellcheck="false" autocomplete="off" dir="ltr" lang="en" data-max="{{$max}}" data-link="{{$link}}">{{.Body}}</textarea>
<p class="note"><span class="xd-len{{if .Over}} bad{{end}}" data-len="" data-alone="{{.LengthAlone}}">{{t "admin.xd.length" "n" .Length "max" $max}}</span></p>
{{- if .Compose}}
<div class="adm-xdforms" role="radiogroup" aria-label="{{ts "admin.xd.form_label"}}">
<label><input type="radio" name="xform" value="link" checked=""/> {{t "admin.xd.form" "f" "link"}}</label>
<label><input type="radio" name="xform" value="image"/> {{t "admin.xd.form" "f" "image"}}</label>
<label><input type="radio" name="xform" value="image_reply"/> {{t "admin.xd.form" "f" "image_reply"}}</label>
</div>
{{- end}}
<div class="adm-rowacts">
<button type="submit" class="btn sm">{{t "admin.xd.save"}}</button>
{{- if and .Compose (not .Over)}}
<a class="btn sm adm-lnk" data-compose="" data-for="link" href="{{.Compose}}" target="_blank" rel="noopener noreferrer">{{t "admin.xd.open"}}</a>
{{- end}}
{{- if and .ComposeAlone (not .OverAlone)}}
<a class="btn sm adm-lnk" data-compose="" data-for="image image_reply" href="{{.ComposeAlone}}" target="_blank" rel="noopener noreferrer" hidden="">{{t "admin.xd.open"}}</a>
{{- end}}
{{- if .Card}}
<button type="button" class="btn sm" data-act="xdcopyimg" data-img="{{.Card}}" data-for="image image_reply" hidden="">{{t "admin.xd.copy_image"}}</button>
<a class="btn sm adm-lnk" href="{{.Card}}" download="{{.CardName}}" data-for="image image_reply" hidden="">{{t "admin.xd.download_image"}}</a>
{{- end}}
{{- with .Link}}
<button type="button" class="btn sm" data-act="xdcopylink" data-link="{{.}}" data-for="image_reply" hidden="">{{t "admin.xd.copy_link"}}</button>
{{- end}}
<span class="bad" data-over=""{{if not .Over}} hidden=""{{end}}>{{t "admin.xd.over_link"}}</span>
<span class="dim" data-unsaved="" hidden="">{{t "admin.xd.save_first"}}</span>
</div>
<p class="acct-st" role="status" aria-live="polite"></p>
</form>
<form class="acct-form adm-xdpost" data-d="{{.ID}}" data-v="{{.Version}}" novalidate="">
<div class="acct-row">
<label for="xd-url-{{.ID}}">{{t "admin.xd.post_url"}}</label>
<input class="acct-in" id="xd-url-{{.ID}}" type="url" name="post_url" maxlength="200" autocomplete="off" spellcheck="false" autocapitalize="none" inputmode="url" dir="ltr"/>
<span class="adm-rowacts">
<button type="submit" class="btn sm" data-confirm="{{ts "btn.confirm"}}">{{t "admin.xd.mark_posted"}}</button>
<button type="button" class="btn sm acct-del" data-act="xddiscard" data-d="{{.ID}}" data-v="{{.Version}}" data-confirm="{{ts "btn.confirm"}}">{{t "admin.xd.discard"}}</button>
</span>
</div>
<p class="acct-st" role="status" aria-live="polite"></p>
</form>
</article>
{{- end}}
</div>
{{template "pager" .PendPager}}
</div>
{{- else}}
<p class="note">{{t "admin.xd.empty"}}</p>
{{- end}}
</section>

<section class="sec" id="history" aria-labelledby="h-xdh">
<h2 class="h2" id="h-xdh"><span class="h" aria-hidden="true"># </span>{{t "admin.xd.history_h2"}}</h2>
<div class="adm-region" id="r-xdhistory" data-page-region="r-xdhistory">
{{- if .History}}
<div class="tbl-x">
<table class="aff adm-tbl adm-wide">
<thead><tr><th scope="col">{{t "admin.xd.col" "c" "stage"}}</th><th scope="col">{{t "admin.xd.col" "c" "cve"}}</th><th scope="col">{{t "admin.xd.col" "c" "status"}}</th><th scope="col">{{t "admin.xd.col" "c" "decided"}}</th><th scope="col">{{t "admin.xd.col" "c" "by"}}</th><th scope="col">{{t "admin.xd.col" "c" "post"}}</th><th scope="col">{{t "admin.xd.col" "c" "form"}}</th><th scope="col">{{t "admin.xd.col" "c" "actions"}}</th></tr></thead>
<tbody>
{{- range .History}}
<tr id="d-{{.ID}}">
<td><span class="{{.CodeClass}} b">+{{.Code}}</span></td>
<td>{{if .CVEHref}}<a href="{{.CVEHref}}">{{.CVE}}</a>{{else}}<code>{{.CVE}}</code>{{end}}</td>
<td><span class="adm-st {{if .Discarded}}suspended{{else}}active{{end}}">{{t "admin.xd.status" "s" .Status}}</span></td>
<td>{{.Decided.HTML}}</td>
<td>{{if .ByHref}}<a href="{{.ByHref}}">{{if .By}}<bdi>@{{.By}}</bdi>{{else}}{{t "admin.user.no_handle"}}{{end}}</a>{{else}}—{{end}}</td>
<td>{{with .PostURL}}<a href="{{.}}" target="_blank" rel="noopener noreferrer nofollow">{{t "admin.x.on_x"}}</a>{{else}}—{{end}}</td>
<td>{{with .Form}}{{t "admin.xd.form" "f" .}}{{else}}—{{end}}</td>
<td>{{if .Discarded}}<form class="acct-form" novalidate=""><div class="adm-rowacts"><button type="button" class="btn sm" data-act="xdrestore" data-d="{{.ID}}" data-v="{{.Version}}" data-confirm="{{ts "btn.confirm"}}">{{t "admin.xd.restore"}}</button></div><p class="acct-st" role="status" aria-live="polite"></p></form>{{end}}</td>
</tr>
{{- end}}
</tbody>
</table>
</div>
{{template "pager" .HistPager}}
{{- else}}
<p class="note">{{t "admin.xd.history_empty"}}</p>
{{- end}}
</div>
</section>
{{template "reauthpanel" .}}
{{- end}}
</main>
</div>
</div>
{{end}}{{end}}
