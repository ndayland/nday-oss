{{define "content"}}{{with .Data}}
<div class="page">
<div class="wrap">
<main class="main adm" id="main" data-page="admin">
{{template "adminhead" .}}
{{- with .Body}}
<section class="sec" aria-labelledby="h-coll">
<h2 class="h2" id="h-coll"><span class="h" aria-hidden="true"># </span>{{t "admin.sys.collectors_h2"}}</h2>
<div class="tbl-x">
<table class="aff adm-tbl adm-wide">
<thead><tr><th scope="col">{{t "admin.sys.col" "col" "collector"}}</th><th scope="col">{{t "admin.sys.col" "col" "status"}}</th><th scope="col">{{t "admin.sys.col" "col" "last_run"}}</th><th scope="col">{{t "admin.sys.col" "col" "last_success"}}</th><th scope="col">{{t "admin.sys.col" "col" "error"}}</th></tr></thead>
<tbody>
{{- range .Collectors}}
<tr><td>{{.Name}}{{if not .Public}} <span class="adm-st hidden">{{t "admin.sys.not_public"}}</span>{{end}}</td><td><span class="{{.Class}}">{{.Status}}</span></td><td>{{.LastRun.HTML}}</td><td>{{.LastOK.HTML}}</td><td><bdi class="adm-err">{{.Error}}</bdi></td></tr>
{{- end}}
</tbody>
</table>
</div>
<p class="note">{{if .StateAt}}{{t "admin.sys.state_at" "time" .StateAt}}{{else}}{{t "admin.sys.state_never"}}{{end}}{{with .StateError}} {{t "admin.sys.state_error" "error" .}}{{end}}</p>
</section>
<section class="sec" aria-labelledby="h-db">
<h2 class="h2" id="h-db"><span class="h" aria-hidden="true"># </span>{{t "admin.sys.db_h2"}}</h2>
<p class="note">{{t "admin.sys.db_size" "size" .DBSize}} {{t "admin.sys.rows_note"}}</p>
<div class="tbl-x">
<table class="aff adm-tbl adm-wide">
<thead><tr><th scope="col">{{t "admin.sys.col" "col" "table"}}</th><th scope="col" class="r">{{t "admin.sys.col" "col" "rows"}}</th><th scope="col" class="r">{{t "admin.sys.col" "col" "size"}}</th></tr></thead>
<tbody>
{{- range .Tables}}
<tr><td><code>{{.Name}}</code></td><td class="r">{{if .Estimate}}~{{end}}{{.Rows}}</td><td class="r">{{.Size}}</td></tr>
{{- end}}
</tbody>
</table>
</div>
</section>
<section class="sec" aria-labelledby="h-roll">
<h2 class="h2" id="h-roll"><span class="h" aria-hidden="true"># </span>{{t "admin.sys.stats_h2"}}</h2>
<p class="note">{{if .StatsLast}}{{t "admin.sys.stats_line" "files" .StatsFiles "lines" .StatsLines "bad" .StatsBad "time" .StatsLast "file" .StatsFile}}{{else}}{{t "admin.sys.stats_never"}}{{end}}</p>
</section>
<section class="sec" aria-labelledby="h-logs">
<h2 class="h2" id="h-logs"><span class="h" aria-hidden="true"># </span>{{t "admin.sys.logs_h2"}}</h2>
{{- if .LogsOff}}
<p class="note">{{t "admin.sys.logs_off"}}</p>
{{- else if .LogsMissing}}
<p class="note">{{t "admin.sys.logs_missing"}}</p>
{{- else}}
<p class="note">{{if .LogFiles}}{{t "admin.sys.logs_files" "files" .LogFiles}}{{else}}{{t "admin.sys.logs_nofile"}}{{end}}{{if .LogsUnread}} {{t "admin.sys.logs_unreadable" "n" .LogsUnread}}{{end}}{{if .LogsCut}} {{t "admin.sys.logs_cut"}}{{end}}</p>
{{- if .Logs}}
<div class="tbl-x">
<table class="aff adm-tbl adm-wide adm-logs">
<thead><tr><th scope="col">{{t "admin.sys.col" "col" "time"}}</th><th scope="col">{{t "admin.sys.col" "col" "level"}}</th><th scope="col">{{t "admin.sys.col" "col" "message"}}</th></tr></thead>
<tbody>
{{- range .Logs}}
<tr><td><code dir="ltr">{{.Time}}</code></td><td><span class="{{if eq .Level "ERROR"}}bad{{else}}warn{{end}}">{{.Level}}</span></td><td><bdi>{{.Msg}}</bdi>{{with .Attrs}}<br/><code class="adm-det" dir="ltr">{{.}}</code>{{end}}</td></tr>
{{- end}}
</tbody>
</table>
</div>
{{- else}}
<p class="note">{{t "admin.sys.logs_none"}}</p>
{{- end}}
{{- end}}
</section>
<section class="sec" aria-labelledby="h-proc">
<h2 class="h2" id="h-proc"><span class="h" aria-hidden="true"># </span>{{t "admin.sys.process_h2"}}</h2>
<dl class="facts">
<div><dt>{{t "admin.sys.field" "field" "started"}}</dt><dd>{{.Started.HTML}}</dd></div>
<div><dt>{{t "admin.sys.field" "field" "go"}}</dt><dd><code>{{.GoVersion}}</code></dd></div>
<div><dt>{{t "admin.sys.field" "field" "build"}}</dt><dd><code>{{.BuildPath}} {{.BuildVersion}}</code></dd></div>
<div><dt>{{t "admin.sys.field" "field" "revision"}}</dt><dd><code>{{.Revision}}</code>{{if .Modified}} {{t "admin.sys.modified"}}{{end}}{{with .BuildTime}} <code>{{.}}</code>{{end}}</dd></div>
<div><dt>{{t "admin.sys.field" "field" "goroutines"}}</dt><dd>{{.Goroutines}}</dd></div>
</dl>
{{- if .Pools}}
<div class="tbl-x">
<table class="aff adm-tbl adm-wide">
<thead><tr><th scope="col">{{t "admin.sys.col" "col" "pool"}}</th><th scope="col" class="r">{{t "admin.sys.col" "col" "size"}}</th><th scope="col" class="r">{{t "admin.sys.col" "col" "in_use"}}</th><th scope="col" class="r">{{t "admin.sys.col" "col" "idle"}}</th></tr></thead>
<tbody>
{{- range .Pools}}
<tr><td><code>{{.Name}}</code></td><td class="r">{{.Size}}</td><td class="r">{{if .Known}}{{.InUse}}{{else}}—{{end}}</td><td class="r">{{if .Known}}{{.Idle}}{{else}}—{{end}}</td></tr>
{{- end}}
</tbody>
</table>
</div>
{{- end}}
</section>
{{- end}}
</main>
</div>
</div>
{{end}}{{end}}
